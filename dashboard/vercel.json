{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "functions": { "api/handler.js": { "maxDuration": 30 } },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/handler?__path=:path*" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://*.private.blob.vercel-storage.com; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
